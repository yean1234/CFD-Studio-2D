/*--------------------------------*- C++ -*----------------------------------*/
FoamFile { version 2.0; format ascii; class dictionary; object controlDict; }
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// config.json 자동 생성
application     icoReactingMultiphaseInterFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         60;
deltaT          1e-05;
adjustTimeStep  yes;
maxCo           0.5;
maxAlphaCo      0.5;
maxDeltaT       0.002;
writeControl    adjustableRunTime;
writeInterval   0.5;
purgeWrite      0;
writeFormat     binary;
writePrecision  8;
timeFormat      general;
timePrecision   6;
runTimeModifiable yes;

functions
{
    vizFields  // 시각화 전용 고빈도 저장(기포·액체 상분율·유동·온도, 0.01s) — 전체 상태 저장(0.5s)은 재시작 앵커로 유지
    {
        type            writeObjects;
        libs            (utilityFunctionObjects);
        objects         (alpha.vapour alpha.water U T);
        writeControl    adjustableRunTime;
        writeInterval   0.01;
    }
vaporVol
    {
        type            volFieldValue;
        libs            (fieldFunctionObjects);
        operation       volIntegrate;
        fields          (alpha.vapour);
        regionType      all;
        writeFields     false;
        writeControl    timeStep;
        writeInterval   20;
        log             false;
    }
    Tpeak      // 원격자 기준 최고·최저 온도 — 벽 과열도 진단용
    {         // (시각화용 therm_*.bin 은 10 mm 평균이라 첨두를 놓침)
        type            volFieldValue;
        libs            (fieldFunctionObjects);
        operation       max;
        fields          (T);
        regionType      all;
        writeFields     false;
        writeControl    timeStep;
        writeInterval   50;
        log             false;
    }
    TcpuWall   // CPU 벽면 최고 온도 — volFieldValue 는 내부장만 보므로 패치로 따로 잰다
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        regionType      patch;
        name            cpu;
        operation       max;
        fields          (T);
        writeFields     false;
        writeControl    timeStep;
        writeInterval   50;
        log             false;
    }
    Tfloor
    {
        type            volFieldValue;
        libs            (fieldFunctionObjects);
        operation       min;
        fields          (T);
        regionType      all;
        writeFields     false;
        writeControl    timeStep;
        writeInterval   50;
        log             false;
    }
    coilT      // 에너지 감사: Q_coil = hA(T-Ta) = 195.20 x (T평균 - 293.15) W ↔ 입력 265 W
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        regionType      patch;
        name            coil;
        operation       areaAverage;
        fields          (T);
        writeFields     false;
        writeControl    timeStep;
        writeInterval   200;
        log             false;
    }
    probesT    // 가상 열전대 (config.json probes_mm) ★정확 좌표 수령 시 교체
    {
        type            probes;
        libs            (sampling);
        fields          (T);
        probeLocations
        (
            (0.228 0.12 0.035)
            (0.2 0.38 0.035)
            (0.295 0.43 0.035)
            (0.265 0.69 0.035)
        );
        writeControl    timeStep;
        writeInterval   50;
    }
}
